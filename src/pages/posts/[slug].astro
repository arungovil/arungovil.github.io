---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { formatDate } from "../../lib/format.js";

export async function getStaticPaths() {
  return (await getCollection("posts")).map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { title, date, topic, description, cover } = post.data;
const { Content } = await render(post);
---
<Base title={`${title} · Arun Govil`} {description}>
  <article>
    <h1>{title}</h1>
    <p><small>{formatDate(date)} · {topic}</small></p>
    {cover && <img src={cover} alt="" />}
    <Content />
  </article>
</Base>
<style>
  /* fixed box reserves the space, so text doesn't jump when the cover loads */
  img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin-block: 1.5rem;
    border-radius: 4px;
  }
</style>
